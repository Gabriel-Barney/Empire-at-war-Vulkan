# Test suites: every CTest entry belongs to exactly one suite, carried as a label.
#
#   synthetic  needs nothing outside the checkout. Runs with ALAMO_FOC_DATA / ALAMO_EAW_DATA / ALAMO_Q2_TRACES unset and
#              every Vulkan driver hidden (VK_LOADER_DRIVERS_DISABLE=*), so it behaves the same on a developer machine
#              and on a hosted runner without game data or a GPU. This is the required suite for hosted CI.
#   retail     needs the installed game (ALAMO_FOC_DATA, sometimes ALAMO_EAW_DATA, or extracted/foc_data_text.zip).
#   vulkan     needs a Vulkan 1.3 device.
#   traces     needs retail trace captures (ALAMO_Q2_TRACES).
#
# Optional-suite entries run through alamo_test_gate, which exits 77 (SKIP_RETURN_CODE) with a "SKIP-PREREQ" reason
# when a prerequisite is missing, turns "SKIP ..." lines the test prints for that suite into a skipped result, and fails
# instead of skipping when ALAMO_TEST_REQUIRE names the suite. A test that mixes synthetic checks with optional ones
# keeps its name for the synthetic entry and gets one companion entry per optional suite (<name>_retail,
# <name>_vulkan, <name>_retail_vulkan), so a skipped data or GPU part shows up as its own skipped result.
#
# tests/test_suites.txt says which tests are not purely synthetic (see the header there); everything it does not list
# is synthetic. tests/required_synthetic.txt lists the synthetic entries a full configure must produce;
# tools/test_report.py fails a synthetic run that is missing one. README.md "Test suites" has the commands.
#
# Mechanism: add_test is overridden so the command of each test is recorded; the suite labels, environment and
# companion entries are added by a deferred call at the end of the directory that created the test, after its own
# set_tests_properties calls (whose properties the companions copy).

set(ALAMO_TEST_SUITES_FILE "${PROJECT_SOURCE_DIR}/tests/test_suites.txt")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ALAMO_TEST_SUITES_FILE}")

# Manifest: "<test name or ^regex$> <entry> [<entry>...]"; an entry is <suite>[+<suite>][:<need>,<need>...].
set(_alamo_suite_rules "")
file(STRINGS "${ALAMO_TEST_SUITES_FILE}" _alamo_suite_lines)
set(_alamo_rule_i 0)
foreach(_line IN LISTS _alamo_suite_lines)
  string(REGEX REPLACE "#.*$" "" _line "${_line}")
  string(STRIP "${_line}" _line)
  if(_line STREQUAL "")
    continue()
  endif()
  separate_arguments(_parts UNIX_COMMAND "${_line}")
  list(POP_FRONT _parts _pattern)
  # A trailing "optional": the test exists only in some configurations, so a rule matching nothing is expected.
  set(_optional 0)
  list(GET _parts -1 _tail)
  if(_tail STREQUAL "optional")
    list(POP_BACK _parts)
    set(_optional 1)
  endif()
  set_property(GLOBAL PROPERTY ALAMO_SUITE_RULE_${_alamo_rule_i}_OPTIONAL ${_optional})
  set_property(GLOBAL PROPERTY ALAMO_SUITE_RULE_${_alamo_rule_i}_PATTERN "${_pattern}")
  set_property(GLOBAL PROPERTY ALAMO_SUITE_RULE_${_alamo_rule_i}_ENTRIES "${_parts}")
  set_property(GLOBAL PROPERTY ALAMO_SUITE_RULE_${_alamo_rule_i}_USED 0)
  math(EXPR _alamo_rule_i "${_alamo_rule_i} + 1")
endforeach()
set_property(GLOBAL PROPERTY ALAMO_SUITE_RULE_COUNT ${_alamo_rule_i})

# Entries for a test name: the first matching rule's entries, else "synthetic".
function(_alamo_suite_entries name out)
  get_property(_n GLOBAL PROPERTY ALAMO_SUITE_RULE_COUNT)
  set(_entries synthetic)
  if(_n GREATER 0)
    math(EXPR _last "${_n} - 1")
    foreach(_i RANGE ${_last})
      get_property(_p GLOBAL PROPERTY ALAMO_SUITE_RULE_${_i}_PATTERN)
      set(_hit FALSE)
      if(_p MATCHES "^\\^")
        if(name MATCHES "${_p}")
          set(_hit TRUE)
        endif()
      elseif(name STREQUAL _p)
        set(_hit TRUE)
      endif()
      if(_hit)
        get_property(_entries GLOBAL PROPERTY ALAMO_SUITE_RULE_${_i}_ENTRIES)
        set_property(GLOBAL PROPERTY ALAMO_SUITE_RULE_${_i}_USED 1)
        break()
      endif()
    endforeach()
  endif()
  set(${out} "${_entries}" PARENT_SCOPE)
endfunction()

# Splits an entry "retail+vulkan:foc,eaw" into its suites (retail;vulkan), the gate needs (foc,eaw,vulkan) and the
# companion-name suffix (_retail_vulkan).
function(_alamo_suite_parse entry suites_out needs_out suffix_out)
  string(FIND "${entry}" ":" _colon)
  set(_needs "")
  if(_colon GREATER -1)
    string(SUBSTRING "${entry}" 0 ${_colon} _s)
    math(EXPR _from "${_colon} + 1")
    string(SUBSTRING "${entry}" ${_from} -1 _n)
    string(REPLACE "," ";" _needs "${_n}")
    # file:<path> is relative to the source tree; the gate runs in the test's build folder, so pass it absolute.
    set(_abs "")
    foreach(_need IN LISTS _needs)
      if(_need MATCHES "^file:(.*)$" AND NOT IS_ABSOLUTE "${CMAKE_MATCH_1}")
        set(_need "file:${CMAKE_SOURCE_DIR}/${CMAKE_MATCH_1}")
      endif()
      list(APPEND _abs "${_need}")
    endforeach()
    set(_needs "${_abs}")
  else()
    set(_s "${entry}")
  endif()
  string(REPLACE "+" ";" _given "${_s}")
  foreach(_x IN LISTS _given)
    if(NOT _x MATCHES "^(synthetic|retail|vulkan|traces)$")
      message(FATAL_ERROR "tests/test_suites.txt: unknown suite '${_x}' in '${entry}'")
    endif()
  endforeach()
  # Canonical order, so "vulkan+retail" and "retail+vulkan" name the same companion.
  set(_suites "")
  set(_suffix "")
  set(_explicit_needs "${_needs}")
  foreach(_x synthetic retail vulkan traces)
    if(NOT _x IN_LIST _given)
      continue()
    endif()
    list(APPEND _suites ${_x})
    string(APPEND _suffix "_${_x}")
    if(_x STREQUAL "retail" AND NOT _explicit_needs MATCHES "(^|;)(foc|eaw|file:[^;]*)(;|$)")
      list(APPEND _needs foc)
    elseif(_x STREQUAL "vulkan")
      list(APPEND _needs vulkan)
    elseif(_x STREQUAL "traces")
      list(APPEND _needs traces)
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _needs)
  list(JOIN _needs "," _needs)
  set(${suites_out} "${_suites}" PARENT_SCOPE)
  set(${needs_out} "${_needs}" PARENT_SCOPE)
  set(${suffix_out} "${_suffix}" PARENT_SCOPE)
endfunction()

# The environment an entry runs in: game data only for retail / traces entries, Vulkan drivers only for vulkan ones.
function(_alamo_suite_apply_env name suites)
  string(REPLACE ";" "+" _label_list "${suites}")
  # Files written for a person (PNGs, coverage reports) go to one folder per entry under the build tree
  # (alamo::test::artifact_dir()), so parallel entries and the companions of a mixed test never overwrite each other.
  set(_mods "ALAMO_TEST_SUITE=set:${_label_list}" "ALAMO_TEST_ARTIFACT_DIR=set:${CMAKE_BINARY_DIR}/artifacts/${name}")
  # Each entry gets its own TEMP / TMP. Tests use fixed names under temp_directory_path(), so a test and its companion
  # (or two runs of one tree) running at once overwrote each other's files there (alamo_data_tests under suite all).
  file(TO_NATIVE_PATH "${CMAKE_BINARY_DIR}/tmp/${name}" _tmp)
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/tmp/${name}")
  list(APPEND _mods "TEMP=set:${_tmp}" "TMP=set:${_tmp}")
  if(NOT "retail" IN_LIST suites AND NOT "traces" IN_LIST suites)
    list(APPEND _mods "ALAMO_FOC_DATA=unset:" "ALAMO_EAW_DATA=unset:")
  endif()
  if(NOT "traces" IN_LIST suites)
    list(APPEND _mods "ALAMO_Q2_TRACES=unset:")
  endif()
  if(NOT "vulkan" IN_LIST suites)
    list(APPEND _mods "VK_LOADER_DRIVERS_DISABLE=set:*")
  endif()
  set_property(TEST ${name} APPEND PROPERTY ENVIRONMENT_MODIFICATION ${_mods})
  set_property(TEST ${name} APPEND PROPERTY LABELS ${suites})
endfunction()

# Rebuilds the recorded add_test arguments of `name` as `newname`, with the gate in front of the command.
function(_alamo_suite_add_gated name newname suites needs)
  get_property(_argc GLOBAL PROPERTY ALAMO_TEST_${name}_ARGC)
  math(EXPR _last "${_argc} - 1")
  set(_fwd "")
  set(_after_command FALSE)
  set(_in_command FALSE)
  string(REPLACE ";" "+" _suite_arg "${suites}")
  foreach(_i RANGE ${_last})
    get_property(_a GLOBAL PROPERTY ALAMO_TEST_${name}_ARG${_i})
    if(_i EQUAL 1)
      set(_a "${newname}")
    endif()
    if(_after_command)
      # First word of the command: a bare target name becomes its file, since it is no longer in first position.
      if(_a MATCHES "^[A-Za-z0-9_]+$")
        set(_a "$<TARGET_FILE:${_a}>")
      endif()
      list(APPEND _fwd "$<TARGET_FILE:alamo_test_gate>" "--suite" "${_suite_arg}" "--needs" "${needs}" "--")
      set(_after_command FALSE)
      set(_in_command TRUE)
    elseif(_a STREQUAL "COMMAND")
      set(_after_command TRUE)
    elseif(_a MATCHES "^(WORKING_DIRECTORY|CONFIGURATIONS|COMMAND_EXPAND_LISTS)$")
      set(_in_command FALSE)
    endif()
    string(REPLACE ";" "\\;" _a "${_a}")
    list(APPEND _fwd "${_a}")
  endforeach()
  _add_test(${_fwd})
  set_property(TEST ${newname} PROPERTY SKIP_RETURN_CODE 77)
endfunction()

set(_alamo_copied_test_props TIMEOUT ENVIRONMENT ENVIRONMENT_MODIFICATION PASS_REGULAR_EXPRESSION FAIL_REGULAR_EXPRESSION
    WILL_FAIL PROCESSORS RUN_SERIAL RESOURCE_LOCK RESOURCE_GROUPS FIXTURES_REQUIRED DEPENDS COST TIMEOUT_SIGNAL_NAME)

# Deferred to the end of the directory that created the test.
function(_alamo_suite_finish name)
  _alamo_suite_entries(${name} _entries)
  get_test_property(${name} LABELS _labels)
  # Companions first, so they copy the test's own properties before the synthetic environment is added to it.
  set(_first TRUE)
  foreach(_e IN LISTS _entries)
    _alamo_suite_parse("${_e}" _suites _needs _suffix)
    if(_first)
      set(_first FALSE)
      if(NOT _suites STREQUAL "synthetic")
        set(_primary_suites "${_suites}")
        continue()  # the primary entry itself was gated when it was added
      endif()
      set(_primary_suites synthetic)
      continue()
    endif()
    if(_suites STREQUAL "synthetic")
      message(FATAL_ERROR "tests/test_suites.txt: '${name}': synthetic must be the first entry")
    endif()
    set(_comp "${name}${_suffix}")
    _alamo_suite_add_gated(${name} ${_comp} "${_suites}" "${_needs}")
    foreach(_p IN LISTS _alamo_copied_test_props)
      get_test_property(${name} ${_p} _v)
      if(NOT _v STREQUAL "NOTFOUND" AND NOT "${_v}" STREQUAL "")
        set_property(TEST ${_comp} PROPERTY ${_p} "${_v}")
      endif()
    endforeach()
    if("slow" IN_LIST _labels)
      set_property(TEST ${_comp} APPEND PROPERTY LABELS slow)
    endif()
    _alamo_suite_apply_env(${_comp} "${_suites}")
    set_property(GLOBAL APPEND PROPERTY ALAMO_SUITE_COMPANIONS ${_comp})
  endforeach()
  _alamo_suite_apply_env(${name} "${_primary_suites}")
  if(NOT _primary_suites STREQUAL "synthetic")
    set_property(TEST ${name} PROPERTY SKIP_RETURN_CODE 77)
  endif()
endfunction()

function(add_test)
  if(NOT ARGV0 STREQUAL "NAME")
    message(FATAL_ERROR "add_test(${ARGV0} ...): use the add_test(NAME <name> COMMAND ...) form (cmake/AlamoTestSuites.cmake)")
  endif()
  set(name "${ARGV1}")
  set_property(GLOBAL PROPERTY ALAMO_TEST_${name}_ARGC ${ARGC})
  math(EXPR _last "${ARGC} - 1")
  set(_fwd "")
  foreach(_i RANGE ${_last})
    set_property(GLOBAL PROPERTY ALAMO_TEST_${name}_ARG${_i} "${ARGV${_i}}")
    string(REPLACE ";" "\\;" _a "${ARGV${_i}}")
    list(APPEND _fwd "${_a}")
  endforeach()
  _alamo_suite_entries(${name} _entries)
  list(GET _entries 0 _first)
  _alamo_suite_parse("${_first}" _suites _needs _suffix)
  if(_suites STREQUAL "synthetic")
    _add_test(${_fwd})
  else()
    _alamo_suite_add_gated(${name} ${name} "${_suites}" "${_needs}")
  endif()
  set_property(GLOBAL APPEND PROPERTY ALAMO_ALL_TESTS ${name})
  # A deferred call reads its variables when it runs, so the name is spliced in now.
  cmake_language(EVAL CODE "cmake_language(DEFER CALL _alamo_suite_finish [==[${name}]==])")
endfunction()

# Called at the end of the top-level CMakeLists.txt: a manifest rule that matched no test is stale (a renamed test
# would otherwise silently fall back to synthetic and run without its gate).
function(alamo_test_suites_check)
  get_property(_n GLOBAL PROPERTY ALAMO_SUITE_RULE_COUNT)
  if(_n EQUAL 0)
    return()
  endif()
  math(EXPR _last "${_n} - 1")
  set(_stale "")
  foreach(_i RANGE ${_last})
    get_property(_used GLOBAL PROPERTY ALAMO_SUITE_RULE_${_i}_USED)
    get_property(_p GLOBAL PROPERTY ALAMO_SUITE_RULE_${_i}_PATTERN)
    get_property(_opt GLOBAL PROPERTY ALAMO_SUITE_RULE_${_i}_OPTIONAL)
    if(NOT _used AND NOT _opt)
      list(APPEND _stale "${_p}")
    endif()
  endforeach()
  if(_stale)
    message(WARNING "tests/test_suites.txt: rules that match no configured test (renamed, or their module is not "
                    "configured): ${_stale}")
  endif()
endfunction()
