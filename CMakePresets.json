{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "fast",
      "displayName": "Release, incremental (dev.cmd default)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "full",
      "displayName": "Release, fresh configure and clean build",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-full"
    },
    {
      "name": "analyze",
      "displayName": "Release with MSVC /analyze, without the PCH (nightly)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-analyze",
      "cacheVariables": { "ALAMO_ANALYZE": "ON", "ALAMO_PCH": "OFF" }
    },
    {
      "name": "asan",
      "displayName": "Release with MSVC AddressSanitizer (nightly)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": { "ALAMO_ASAN": "ON", "ALAMO_RELEASE_PDB": "ON" }
    }
  ]
}
